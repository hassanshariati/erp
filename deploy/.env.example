# Generic example. Replace values per customer/site; never commit a real .env.
ERPNEXT_VERSION=v16.53.0
COMPOSE_PROJECT_NAME=erp-evaluation
CUSTOM_IMAGE=erp-platform/erpnext
CUSTOM_TAG=v16.53.0-apps1
PULL_POLICY=never
SITE_NAME=erp.example.test
HOST_HTTP_PORT=18080
# Required only when explicitly enabling the HTTPS override:
ACME_EMAIL=admin@example.test

